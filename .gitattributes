# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force specific filetypes
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.db binary
*.png binary
*.jpg binary
*.ico binary
